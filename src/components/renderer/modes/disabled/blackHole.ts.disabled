import { ThemePalette } from "../core/palette";
import { getVisualizerCenter } from "../core/geometry";
import { ModeConfig } from "../createCanvasVisualizer";
import { neonCurrentManager } from "../core/neonCurrent";
import { getVisualizerSettings } from "../../../settings/settingsManager";
import { AudioFeatures } from "../core/audioFeatures";

/**
 * 🕳️ BLACK HOLE - Simulation Astrophysique Volumétrique, Fluide & Poussiéreuse
 * (Inspiré de Gargantua / Interstellar, des simulations Schnittman de la NASA et des quasars réels)
 *
 * 1. Mirage Gravitationnel d'Einstein : Étoiles et poussières d'arrière-plan déformées en arcs
 * 2. Jets Relativistes Polaires : Faisceaux de plasma bipolaires éruptifs jaillissant sur les kicks
 * 3. Vortex de Poussière Cosmique : ~100 filaments de plasma et braises en orbite képlérienne avec traînées fluides
 * 4. Chute libre relativiste : La matière spirale vers l'horizon et s'embrase au passage de l'ISCO
 * 5. Nappe de gaz continue : Accrétion volumétrique soyeuse avec effet Doppler relativiste réaliste
 * 6. Horizon de Schwarzschild & Anneau de Photons scintillant réactif aux aigus
 * 7. Zéro striation parasite, zéro trait moche, gel complet en pause Spotify
 */

interface BackgroundStar {
	baseX: number; // Coordonnée normalisée [-1, 1] relative au centre
	baseY: number;
	brightness: number;
	size: number;
	phase: number;
}

interface AccretionDustParticle {
	normR: number; // 0 (ISCO) à 1 (bord externe)
	angle: number; // Angle azimutal
	speedMul: number;
	size: number;
	brightness: number;
	inwardSpeed: number;
	history: { x: number; y: number }[]; // Traînée fluide
}

interface PolarShockNode {
	dist: number; // Distance le long du jet
	speed: number;
	alpha: number;
	size: number;
}

class RelativisticBlackHoleSim {
	public smoothBass = 0.1;
	public smoothPunch = 0;
	public smoothTreble = 0.1;
	public timeFlow = 0;
	public jetEruption = 0;
	public photonTwinklePhase = 0;

	public stars: BackgroundStar[] = [];
	public dustParticles: AccretionDustParticle[] = [];
	public polarShocks: PolarShockNode[] = [];
	public shockwaves: { radius: number; maxR: number; speed: number; alpha: number }[] = [];

	private lastKickTime = 0;

	constructor() {
		// 1. Initialisation des étoiles du champ profond pour la lentille gravitationnelle
		for (let i = 0; i < 90; i++) {
			const angle = Math.random() * Math.PI * 2;
			const dist = 0.25 + Math.pow(Math.random(), 0.7) * 1.5; // Plus dense autour du champ
			this.stars.push({
				baseX: Math.cos(angle) * dist,
				baseY: Math.sin(angle) * dist,
				brightness: 0.35 + Math.random() * 0.65,
				size: 1.2 + Math.random() * 2.2,
				phase: Math.random() * Math.PI * 2
			});
		}

		// 2. Initialisation des 100 particules de poussière du vortex d'accrétion
		for (let i = 0; i < 110; i++) {
			this.dustParticles.push({
				normR: Math.pow(Math.random(), 0.8), // Plus dense vers le disque interne
				angle: Math.random() * Math.PI * 2,
				speedMul: 0.85 + Math.random() * 0.3,
				size: 1.5 + Math.random() * 3.2,
				brightness: 0.4 + Math.random() * 0.6,
				inwardSpeed: 0.0005 + Math.random() * 0.0012,
				history: []
			});
		}
	}

	public update(
		isPlaying: boolean,
		bass: number,
		punch: number,
		treble: number,
		transient: number,
		speedScale: number,
		maxDist: number
	) {
		if (!isPlaying) {
			this.smoothPunch *= 0.88;
			this.smoothBass += (0.05 - this.smoothBass) * 0.1;
			this.smoothTreble += (0.05 - this.smoothTreble) * 0.1;
			this.jetEruption *= 0.88;
			return;
		}

		// Filtrage passe-bas des dynamiques audio
		this.smoothBass += (bass - this.smoothBass) * 0.14;
		this.smoothPunch += (punch - this.smoothPunch) * 0.22;
		this.smoothTreble += (treble - this.smoothTreble) * 0.2;

		const isKick = punch > 0.36 || (bass > 0.62 && transient > 0.35);
		if (isKick) {
			this.jetEruption = Math.min(2.5, this.jetEruption + punch * 0.9 + transient * 0.5);
		}
		this.jetEruption *= 0.91;

		const speed = (1.0 + this.jetEruption * 0.35 + this.smoothBass * 0.3) * speedScale;
		this.timeFlow += 0.016 * speed;
		this.photonTwinklePhase += 0.04 * speedScale;

		const now = Date.now();

		// Déclenchement d'ondes gravitationnelles et nœuds de jet polaire sur les kicks
		if (isKick && now - this.lastKickTime > 260) {
			this.lastKickTime = now;

			// Onde d'espace-temps
			this.shockwaves.push({
				radius: 20,
				maxR: maxDist * 1.3,
				speed: (14 + punch * 20) * speedScale,
				alpha: 0.85
			});
			if (this.shockwaves.length > 5) this.shockwaves.shift();

			// Nœud de choc dans le jet polaire
			this.polarShocks.push({
				dist: 15,
				speed: (8 + punch * 15) * speedScale,
				alpha: 1.0,
				size: 16 + punch * 22
			});
			if (this.polarShocks.length > 8) this.polarShocks.shift();
		}

		// Mise à jour des ondes de choc gravitationnelles
		for (let i = this.shockwaves.length - 1; i >= 0; i--) {
			const w = this.shockwaves[i];
			w.radius += w.speed;
			const prog = w.radius / w.maxR;
			w.alpha = Math.max(0, 1 - Math.pow(prog, 0.85));
			if (prog >= 1.0 || w.alpha <= 0.02) {
				this.shockwaves.splice(i, 1);
			}
		}

		// Mise à jour des nœuds de plasma des jets polaires
		for (let i = this.polarShocks.length - 1; i >= 0; i--) {
			const s = this.polarShocks[i];
			s.dist += s.speed;
			s.alpha *= 0.95;
			if (s.alpha <= 0.02 || s.dist > maxDist) {
				this.polarShocks.splice(i, 1);
			}
		}

		// Mise à jour des poussières cosmiques du vortex d'accrétion
		for (const p of this.dustParticles) {
			// Rotation képlérienne : v ~ r^-1.5
			const effectiveR = 0.2 + p.normR * 0.8;
			const omega = (0.028 / Math.pow(effectiveR, 1.45)) * p.speedMul * speed;
			p.angle += omega;

			// Chute lente vers l'horizon des événements
			p.normR -= p.inwardSpeed * speed * (1.0 + (1.0 - effectiveR) * 1.8);

			// Réinjection à la frontière externe si la matière plonge dans l'horizon
			if (p.normR <= 0.01) {
				p.normR = 0.95 + Math.random() * 0.05;
				p.angle = Math.random() * Math.PI * 2;
				p.history = [];
			}
		}
	}
}

const sim = new RelativisticBlackHoleSim();

export function drawBlackHole(
	ctx: CanvasRenderingContext2D,
	width: number,
	height: number,
	features: AudioFeatures,
	palette: ThemePalette,
	analysis?: SpotifyAudioAnalysis
) {
	ctx.save();

	const { cx, cy } = getVisualizerCenter(ctx);
	const settings = getVisualizerSettings();
	const speedScale = settings.speedScale ?? 1.0;
	const isPlaying = features.isPlaying ?? true;
	const maxScreenR = Math.sqrt(cx * cx + cy * cy);

	sim.update(
		isPlaying,
		features.bassEnergy,
		features.punch,
		features.trebleEnergy,
		features.transientEnergy,
		speedScale,
		maxScreenR
	);

	const baseR = Math.min(width, height) * 0.38;

	// Dimensions astrophysiques fondamentales
	const rHorizon = baseR * 0.28 * (1.0 - sim.smoothPunch * 0.03);
	const rPhoton = rHorizon * 1.07;
	const rISCO = rHorizon * 1.24;
	const rDiskOuter = baseR * 1.4 * (1.0 + sim.smoothBass * 0.2);
	const tiltSin = 0.27; // Inclinaison de perspective de l'équateur

	// =========================================================================
	// 1. ONDES GRAVITATIONNELLES VAPOREUSES DANS L'ESPACE-TEMPS
	// =========================================================================
	for (const wave of sim.shockwaves) {
		const curR = wave.radius;
		if (curR <= 0) continue;

		ctx.save();
		ctx.translate(cx, cy);
		ctx.scale(1.0, 0.72);

		const waveGrad = ctx.createRadialGradient(0, 0, Math.max(0, curR - 40), 0, 0, curR + 10);
		waveGrad.addColorStop(0, "transparent");
		waveGrad.addColorStop(0.3, palette.veil(wave.alpha * 0.15));
		waveGrad.addColorStop(0.85, palette.rimVeil(wave.alpha * 0.45));
		waveGrad.addColorStop(0.96, palette.highlight);
		waveGrad.addColorStop(1, "transparent");

		ctx.beginPath();
		ctx.arc(0, 0, curR + 10, 0, Math.PI * 2);
		ctx.fillStyle = waveGrad;
		ctx.fill();

		ctx.restore();
	}

	// =========================================================================
	// 2. MIRAGE GRAVITATIONNEL D'EINSTEIN : ÉTOILES DU FOND DÉFORMÉES EN ARCS
	// =========================================================================
	// Les rayons lumineux provenant des étoiles derrière le trou noir sont courbés vers l'extérieur
	const rEinstein = rHorizon * 1.5;
	for (const star of sim.stars) {
		const screenDist = Math.max(width, height) * 0.7;
		const rawX = star.baseX * screenDist;
		const rawY = star.baseY * screenDist;
		const d = Math.sqrt(rawX * rawX + rawY * rawY);
		if (d < 1) continue;

		// Déviation relativiste d'Einstein : les étoiles près de l'horizon sont étirées tangentiellement
		const deflFactor = 1.0 + (rEinstein * rEinstein) / (d * d + rHorizon * 40);
		const lensedX = cx + rawX * deflFactor;
		const lensedY = cy + rawY * deflFactor;

		// Ne pas afficher les étoiles absorbées sous l'horizon
		const finalDist = Math.sqrt((lensedX - cx) * (lensedX - cx) + (lensedY - cy) * (lensedY - cy));
		if (finalDist < rHorizon * 0.95) continue;

		// Facteur d'étirement en arc tangentiel
		const proximity = Math.max(0, 1.0 - (finalDist - rHorizon) / (baseR * 1.6));
		const arcStretch = 1.0 + proximity * 3.5;
		const starAngle = Math.atan2(lensedY - cy, lensedX - cx);

		ctx.save();
		ctx.translate(lensedX, lensedY);
		ctx.rotate(starAngle + Math.PI / 2); // Orientation tangentielle

		const starAlpha = Math.min(1.0, star.brightness * (0.4 + sim.smoothBass * 0.3) * (1.0 + proximity * 0.8));
		const starGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, star.size * arcStretch);
		starGrad.addColorStop(0, "#ffffff");
		starGrad.addColorStop(0.35, palette.highlight);
		starGrad.addColorStop(0.75, palette.rimVeil(starAlpha * 0.6));
		starGrad.addColorStop(1, "transparent");

		ctx.fillStyle = starGrad;
		ctx.beginPath();
		ctx.ellipse(0, 0, star.size * arcStretch, star.size * 0.9, 0, 0, Math.PI * 2);
		ctx.fill();

		ctx.restore();
	}

	// =========================================================================
	// 3. JETS RELATIVISTES POLAIRES BIPOLAIRES (Arrière-plan : moitié supérieure/inférieure)
	// =========================================================================
	// Colonnes de plasma magnétique jaillissant perpendiculairement au disque
	const drawPolarJets = (frontPass: boolean) => {
		const jetLen = baseR * (1.8 + sim.jetEruption * 0.6 + sim.smoothBass * 0.4);
		const jetBaseW = rHorizon * 0.38;
		const jetOuterW = rHorizon * 1.25;

		// Deux pôles : supérieur (dir = -1) et inférieur (dir = 1)
		const dirs = frontPass ? [1] : [-1];

		for (const dir of dirs) {
			ctx.save();
			ctx.translate(cx, cy);

			// Faisceau continu hélicoïdal diaphane
			const jetGrad = ctx.createLinearGradient(0, 0, 0, dir * jetLen);
			const coreAlpha = 0.55 + sim.jetEruption * 0.3 + sim.smoothPunch * 0.15;

			jetGrad.addColorStop(0, "#ffffff");
			jetGrad.addColorStop(0.12, palette.highlight);
			jetGrad.addColorStop(0.45, palette.rimVeil(coreAlpha * 0.5));
			jetGrad.addColorStop(0.85, palette.veil(coreAlpha * 0.2));
			jetGrad.addColorStop(1, "transparent");

			ctx.beginPath();
			ctx.moveTo(-jetBaseW, 0);
			// Courbure subtile de la colonne de plasma magnétique
			const sway = Math.sin(sim.timeFlow * 2.5 + dir) * 12;
			ctx.quadraticCurveTo(-jetOuterW * 0.7 + sway, dir * jetLen * 0.5, -jetOuterW + sway * 1.5, dir * jetLen);
			ctx.lineTo(jetOuterW + sway * 1.5, dir * jetLen);
			ctx.quadraticCurveTo(jetOuterW * 0.7 + sway, dir * jetLen * 0.5, jetBaseW, 0);
			ctx.closePath();

			ctx.fillStyle = jetGrad;
			ctx.fill();

			// Cœur de synchrotron incandescent
			ctx.beginPath();
			ctx.moveTo(-jetBaseW * 0.35, 0);
			ctx.lineTo(-jetOuterW * 0.25 + sway, dir * jetLen * 0.75);
			ctx.lineTo(jetOuterW * 0.25 + sway, dir * jetLen * 0.75);
			ctx.lineTo(jetBaseW * 0.35, 0);
			ctx.closePath();

			const coreGrad = ctx.createLinearGradient(0, 0, 0, dir * jetLen * 0.75);
			coreGrad.addColorStop(0, "#ffffff");
			coreGrad.addColorStop(0.3, palette.highlight);
			coreGrad.addColorStop(1, "transparent");
			ctx.fillStyle = coreGrad;
			ctx.fill();

			// Nœuds de choc (Shock diamonds) en propagation le long du jet
			for (const shock of sim.polarShocks) {
				if (shock.dist > jetLen) continue;
				const shockY = dir * shock.dist;
				const curW = jetBaseW + (jetOuterW - jetBaseW) * (shock.dist / jetLen);

				const diamondGrad = ctx.createRadialGradient(sway, shockY, 0, sway, shockY, shock.size);
				diamondGrad.addColorStop(0, "#ffffff");
				diamondGrad.addColorStop(0.4, palette.highlight);
				diamondGrad.addColorStop(0.8, palette.rimVeil(shock.alpha * 0.6));
				diamondGrad.addColorStop(1, "transparent");

				ctx.fillStyle = diamondGrad;
				ctx.beginPath();
				ctx.ellipse(sway, shockY, curW * 0.8, shock.size * 0.45, 0, 0, Math.PI * 2);
				ctx.fill();
			}

			ctx.restore();
		}
	};

	// 1ère passe : Jet supérieur (en arrière-plan)
	drawPolarJets(false);

	// =========================================================================
	// 4. LENTILLE GRAVITATIONNELLE SUPÉRIEURE (Nappe Veloutée Continue de Matière Arrière)
	// =========================================================================
	const drawLensedSurface = () => {
		const steps = 54;
		const outerPoints: { x: number; y: number }[] = [];
		const innerPoints: { x: number; y: number }[] = [];

		for (let s = 0; s <= steps; s++) {
			const p = s / steps;
			const phi = Math.PI + p * Math.PI; // π à 2π (arrière)
			const cosP = Math.cos(phi);
			const lensHeight = Math.sqrt(Math.max(0, 1.0 - cosP * cosP));

			const lensScaleOut = 0.88 + (0.32 * rHorizon) / rDiskOuter;
			outerPoints.push({
				x: cx + rDiskOuter * cosP,
				y: cy - rDiskOuter * lensHeight * lensScaleOut
			});

			const lensScaleIn = 0.88 + (0.32 * rHorizon) / rISCO;
			innerPoints.push({
				x: cx + rISCO * cosP,
				y: cy - rISCO * lensHeight * lensScaleIn
			});
		}

		ctx.beginPath();
		ctx.moveTo(outerPoints[0].x, outerPoints[0].y);
		for (let i = 1; i < outerPoints.length; i++) {
			const prev = outerPoints[i - 1];
			const curr = outerPoints[i];
			ctx.quadraticCurveTo(prev.x, prev.y, (prev.x + curr.x) / 2, (prev.y + curr.y) / 2);
		}
		ctx.lineTo(innerPoints[innerPoints.length - 1].x, innerPoints[innerPoints.length - 1].y);
		for (let i = innerPoints.length - 2; i >= 0; i--) {
			const next = innerPoints[i + 1];
			const curr = innerPoints[i];
			ctx.quadraticCurveTo(next.x, next.y, (next.x + curr.x) / 2, (next.y + curr.y) / 2);
		}
		ctx.closePath();

		// Dégradé Doppler horizontal sans aspérité
		const topGrad = ctx.createLinearGradient(cx - rDiskOuter, cy, cx + rDiskOuter, cy);
		const intensity = 0.55 + sim.smoothBass * 0.3 + sim.jetEruption * 0.25;

		topGrad.addColorStop(0, "#ffffff");
		topGrad.addColorStop(0.18, palette.highlight);
		topGrad.addColorStop(0.42, palette.rimVeil(intensity));
		topGrad.addColorStop(0.72, palette.veil(intensity * 0.45));
		topGrad.addColorStop(1, palette.veil(0.04));

		ctx.fillStyle = topGrad;
		ctx.fill();

		// Nappe thermique radiale
		const thermalGrad = ctx.createRadialGradient(cx, cy, rISCO * 0.9, cx, cy, rDiskOuter * 1.05);
		thermalGrad.addColorStop(0, palette.highlight);
		thermalGrad.addColorStop(0.22, palette.rimVeil(0.45));
		thermalGrad.addColorStop(0.65, palette.veil(0.18));
		thermalGrad.addColorStop(1, "transparent");

		ctx.save();
		ctx.clip();
		ctx.fillStyle = thermalGrad;
		ctx.fill();
		ctx.restore();
	};

	drawLensedSurface();

	// =========================================================================
	// 5. ARCHE INFÉRIEURE LENSED (Miroir Relativiste Inférieur)
	// =========================================================================
	ctx.save();
	ctx.translate(cx, cy);

	const underR = rHorizon * (1.16 + sim.smoothBass * 0.12);
	const underH = rHorizon * 0.45;

	ctx.beginPath();
	ctx.arc(0, 0, underR + underH, Math.PI * 0.06, Math.PI * 0.94);
	ctx.arc(0, 0, underR, Math.PI * 0.94, Math.PI * 0.06, true);
	ctx.closePath();

	const underGrad = ctx.createLinearGradient(-underR, 0, underR, 0);
	underGrad.addColorStop(0, palette.rimVeil(0.45));
	underGrad.addColorStop(0.4, palette.veil(0.2));
	underGrad.addColorStop(1, "transparent");

	ctx.fillStyle = underGrad;
	ctx.fill();
	ctx.restore();

	// =========================================================================
	// 6. VORTEX DE POUSSIÈRE COSMIQUE (Passe Arrière : Particules Lensed dans l'Arche)
	// =========================================================================
	// Rendu des filaments et braises de poussière passant derrière l'horizon
	const renderDustPass = (isFrontPass: boolean) => {
		for (const p of sim.dustParticles) {
			const sinA = Math.sin(p.angle);
			const cosA = Math.cos(p.angle);
			const isParticleFront = sinA >= 0;

			if (isParticleFront !== isFrontPass) continue;

			const curR = rISCO + p.normR * (rDiskOuter - rISCO);
			let px: number, py: number;

			if (isParticleFront) {
				// Premier plan : plan équatorial incliné
				px = cx + cosA * curR;
				py = cy + sinA * curR * tiltSin;
			} else {
				// Arrière-plan : courbé dans l'arche supérieure par la lentille
				const lensHeight = Math.sqrt(Math.max(0, 1.0 - cosA * cosA));
				const lensScale = 0.88 + (0.32 * rHorizon) / curR;
				px = cx + cosA * curR;
				py = cy - curR * lensHeight * lensScale;
			}

			// Mise à jour de l'historique de traînée pour créer un effet fluide
			if (isPlaying) {
				p.history.unshift({ x: px, y: py });
				if (p.history.length > 5) p.history.pop();
			}

			// Effet Doppler relativiste : intensité maximale sur le flanc gauche approchant
			const cosDir = -cosA;
			const dopplerBoost = Math.pow(Math.max(0.12, 1.0 + cosDir * 0.65), 2.6);
			// Incandescence de marée à l'approche du gouffre
			const tidalHeat = Math.pow(1.0 - p.normR, 2.0);
			const pAlpha = Math.min(
				0.95,
				(0.3 + sim.smoothBass * 0.35 + tidalHeat * 0.4) * p.brightness * dopplerBoost
			);

			// Traînée fluide vaporeuse (vortex dust filament)
			if (p.history.length >= 2) {
				ctx.beginPath();
				ctx.moveTo(p.history[0].x, p.history[0].y);
				for (let h = 1; h < p.history.length; h++) {
					ctx.lineTo(p.history[h].x, p.history[h].y);
				}
				ctx.lineWidth = p.size * (0.7 + tidalHeat * 0.5);
				ctx.strokeStyle = cosDir > 0.2 ? palette.highlight : palette.rimVeil(pAlpha * 0.6);
				ctx.lineCap = "round";
				ctx.stroke();
			}

			// Tête de particule / braise de plasma vaporeuse
			const pSize = p.size * (1.0 + sim.smoothPunch * 0.4 + tidalHeat * 0.6);
			const pGrad = ctx.createRadialGradient(px, py, 0, px, py, pSize * 2.2);
			pGrad.addColorStop(0, cosDir > 0.15 || tidalHeat > 0.6 ? "#ffffff" : palette.highlight);
			pGrad.addColorStop(0.4, palette.rimVeil(pAlpha * 0.8));
			pGrad.addColorStop(1, "transparent");

			ctx.fillStyle = pGrad;
			ctx.beginPath();
			ctx.arc(px, py, pSize * 2.2, 0, Math.PI * 2);
			ctx.fill();
		}
	};

	// Particules de poussière dans l'arche supérieure (arrière)
	renderDustPass(false);

	// =========================================================================
	// 7. HORIZON DES ÉVÉNEMENTS (L'Ombre de Schwarzschild Absolue)
	// =========================================================================
	// Disque d'encre noire parfaite qui masque tout ce qui se trouve derrière
	ctx.save();
	ctx.translate(cx, cy);

	ctx.beginPath();
	ctx.arc(0, 0, rHorizon, 0, Math.PI * 2);
	ctx.fillStyle = "#000000";
	ctx.fill();

	// =========================================================================
	// 8. SPHÈRE DE PHOTONS (Anneau Pur & Scintillation Quantique aux Aigus)
	// =========================================================================
	// Halo doux d'éther
	const pHalo = ctx.createRadialGradient(0, 0, rHorizon * 0.94, 0, 0, rPhoton * 1.25);
	pHalo.addColorStop(0, "transparent");
	pHalo.addColorStop(0.3, "#ffffff");
	pHalo.addColorStop(0.65, palette.highlight);
	pHalo.addColorStop(0.9, palette.rimVeil(0.55));
	pHalo.addColorStop(1, "transparent");

	ctx.fillStyle = pHalo;
	ctx.beginPath();
	ctx.arc(0, 0, rPhoton * 1.25, 0, Math.PI * 2);
	ctx.fill();

	// Liseré pur de l'anneau de photons (sans aucune rayure)
	ctx.beginPath();
	ctx.arc(0, 0, rPhoton, 0, Math.PI * 2);
	ctx.lineWidth = 2.4 + sim.smoothPunch * 1.5;
	ctx.strokeStyle = "#ffffff";
	ctx.shadowBlur = 18 + sim.smoothPunch * 16;
	ctx.shadowColor = palette.solid;
	ctx.stroke();
	ctx.shadowBlur = 0;

	// Micro-scintillations quantiques étincelantes sur l'anneau (réactives aux aigus/treble)
	const numSparks = 16;
	for (let s = 0; s < numSparks; s++) {
		const sparkAngle = (s / numSparks) * Math.PI * 2 + sim.photonTwinklePhase * (s % 2 === 0 ? 1 : -1);
		const sparkShine = Math.sin(sim.photonTwinklePhase * 4.0 + s * 1.7);
		if (sparkShine > 0.45) {
			const sx = Math.cos(sparkAngle) * rPhoton;
			const sy = Math.sin(sparkAngle) * rPhoton;
			const sparkSize = (2.0 + sim.smoothTreble * 3.5) * (sparkShine - 0.4);

			const sparkGrad = ctx.createRadialGradient(sx, sy, 0, sx, sy, sparkSize * 2.5);
			sparkGrad.addColorStop(0, "#ffffff");
			sparkGrad.addColorStop(0.5, palette.highlight);
			sparkGrad.addColorStop(1, "transparent");

			ctx.fillStyle = sparkGrad;
			ctx.beginPath();
			ctx.arc(sx, sy, sparkSize * 2.5, 0, Math.PI * 2);
			ctx.fill();
		}
	}

	ctx.restore();

	// =========================================================================
	// 9. DISQUE D'ACCRÉTION AVANT (Nappe Continue Veloutée & Équatoriale)
	// =========================================================================
	// Coupe le bas de l'horizon au premier plan
	const drawFrontAccretionDisk = () => {
		const steps = 54;
		const outerPoints: { x: number; y: number }[] = [];
		const innerPoints: { x: number; y: number }[] = [];

		for (let s = 0; s <= steps; s++) {
			const p = s / steps;
			const phi = p * Math.PI; // 0 à π (premier plan)
			const cosP = Math.cos(phi);
			const sinP = Math.sin(phi);

			outerPoints.push({
				x: cx + rDiskOuter * cosP,
				y: cy + rDiskOuter * sinP * tiltSin
			});

			innerPoints.push({
				x: cx + rISCO * cosP,
				y: cy + rISCO * sinP * tiltSin
			});
		}

		ctx.beginPath();
		ctx.moveTo(outerPoints[0].x, outerPoints[0].y);
		for (let i = 1; i < outerPoints.length; i++) {
			const prev = outerPoints[i - 1];
			const curr = outerPoints[i];
			ctx.quadraticCurveTo(prev.x, prev.y, (prev.x + curr.x) / 2, (prev.y + curr.y) / 2);
		}
		ctx.lineTo(innerPoints[innerPoints.length - 1].x, innerPoints[innerPoints.length - 1].y);
		for (let i = innerPoints.length - 2; i >= 0; i--) {
			const next = innerPoints[i + 1];
			const curr = innerPoints[i];
			ctx.quadraticCurveTo(next.x, next.y, (next.x + curr.x) / 2, (next.y + curr.y) / 2);
		}
		ctx.closePath();

		// Dégradé Doppler horizontal
		const frontGrad = ctx.createLinearGradient(cx - rDiskOuter, cy, cx + rDiskOuter, cy);
		const fIntensity = 0.6 + sim.smoothBass * 0.35 + sim.jetEruption * 0.3;

		frontGrad.addColorStop(0, "#ffffff");
		frontGrad.addColorStop(0.16, palette.highlight);
		frontGrad.addColorStop(0.44, palette.rimVeil(fIntensity));
		frontGrad.addColorStop(0.76, palette.veil(fIntensity * 0.45));
		frontGrad.addColorStop(1, palette.veil(0.05));

		ctx.fillStyle = frontGrad;
		ctx.fill();

		// Chaleur thermique radiale continue
		const frontHeat = ctx.createRadialGradient(cx, cy, rISCO * 0.85, cx, cy, rDiskOuter);
		frontHeat.addColorStop(0, "#ffffff");
		frontHeat.addColorStop(0.2, palette.highlight);
		frontHeat.addColorStop(0.6, palette.rimVeil(0.45));
		frontHeat.addColorStop(1, "transparent");

		ctx.save();
		ctx.clip();
		ctx.fillStyle = frontHeat;
		ctx.fill();
		ctx.restore();
	};

	drawFrontAccretionDisk();

	// =========================================================================
	// 10. VORTEX DE POUSSIÈRE COSMIQUE (Passe Avant : Filaments Fluides au Premier Plan)
	// =========================================================================
	renderDustPass(true);

	// =========================================================================
	// 11. JETS RELATIVISTES POLAIRES (Passe Avant : Jet Inférieur Jaillissant vers l'Avant)
	// =========================================================================
	drawPolarJets(true);

	// =========================================================================
	// 12. ONDE DE COURANT NÉON DYNAMIQUE DANS LE DISQUE
	// =========================================================================
	const activeWaves = neonCurrentManager.getActiveWaves(0);
	const mainNeon = activeWaves.length > 0 ? activeWaves[activeWaves.length - 1] : null;
	if (mainNeon && mainNeon.intensity > 0.05 && mainNeon.wavePos >= 0 && mainNeon.wavePos <= 1.0) {
		const neonRad = rDiskOuter - mainNeon.wavePos * (rDiskOuter - rISCO);
		ctx.save();
		ctx.translate(cx, cy);

		const neonDustGrad = ctx.createRadialGradient(0, 0, Math.max(0, neonRad - 20), 0, 0, neonRad + 20);
		neonDustGrad.addColorStop(0, "transparent");
		neonDustGrad.addColorStop(0.45, palette.highlight);
		neonDustGrad.addColorStop(0.75, palette.rimVeil(mainNeon.intensity * 0.8));
		neonDustGrad.addColorStop(1, "transparent");

		ctx.beginPath();
		ctx.ellipse(0, 0, neonRad + 14, (neonRad + 14) * tiltSin, 0, 0, Math.PI * 2);
		ctx.fillStyle = neonDustGrad;
		ctx.fill();

		ctx.restore();
	}

	ctx.restore();
}

export const modeConfig: ModeConfig = {
	id: "black-hole",
	name: "🕳️ Black Hole",
	render(ctx, width, height, features, palette, analysis) {
		drawBlackHole(ctx, width, height, features, palette, analysis);
	}
};
