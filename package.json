{
  "name": "spicetify-visualizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "apply": "npm run build && npm run build-local && spicetify apply",
    "deploy": "npm run build && npm run build-local && spicetify apply",
    "discover": "node scripts/discover-modes.js",
    "prebuild": "node scripts/discover-modes.js",
    "build": "spicetify-creator",
    "prebuild-local": "node scripts/discover-modes.js",
    "build-local": "spicetify-creator --out=dist --minify",
    "prewatch": "node scripts/discover-modes.js",
    "watch": "spicetify-creator --watch",
    "format": "prettier --write src/"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "prettier": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "spicetify-creator": "^1.0.17",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "spicetify-utils": "github:Konsl/spicetify-utils"
  }
}
